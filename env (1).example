# ─── Goalwire Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here                  # Dev guild for instant slash cmd sync

# Football API  (https://www.api-football.com)
FOOTBALL_API_KEY=your_football_api_key_here
FOOTBALL_API_HOST=v3.football.api-sports.io

# Channel IDs  (right-click channel → Copy Channel ID)
LIVE_SCORES_CHANNEL_ID=
FIXTURES_CHANNEL_ID=
NEWS_CHANNEL_ID=
TRANSFERS_CHANNEL_ID=
STANDINGS_CHANNEL_ID=
RESULTS_CHANNEL_ID=
REMINDERS_CHANNEL_ID=
TOURNAMENT_CATEGORY_ID=              # Category where tournament channels are created

# Database
DB_PATH=goalwire.db

# Bot Settings
BOT_PREFIX=!
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LIVE_UPDATE_INTERVAL=60              # seconds between live score polls
FIXTURE_LOOKAHEAD_DAYS=7
NEWS_POLL_INTERVAL=300               # seconds between news polls
REMINDER_CHECK_INTERVAL=60           # seconds between reminder checks

# Optional: Timezone for display (IANA format)
DEFAULT_TIMEZONE=UTC
