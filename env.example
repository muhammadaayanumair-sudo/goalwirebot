# ─────────────────────────────────────────────
#  MatchDay Bot — Environment Variables
#  Copy this file to .env and fill in your values
#  On Railway: add these in the Variables tab
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────

# Discord bot token (from discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# football-data.org API key (free tier available)
# Get one at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# ── Optional (AI features) ────────────────────

# OpenAI API key — enables /preview /predict /summarize /scout /trivia
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Optional (Database) ───────────────────────

# Railway auto-sets this when you add a PostgreSQL plugin
# Leave blank to use local SQLite (fine for development)
DATABASE_URL=

# ── Optional (Redis) ──────────────────────────

# Railway auto-sets this when you add a Redis plugin
# Enables faster caching, falls back to in-memory if not set
REDIS_URL=

# ── Bot behaviour ─────────────────────────────

# Default league code when none specified (PL = Premier League)
DEFAULT_LEAGUE=PL

# How long to cache API responses (seconds)
CACHE_TTL=60

# How often the alerts task polls for live match updates (seconds)
ALERT_POLL_INTERVAL=60
