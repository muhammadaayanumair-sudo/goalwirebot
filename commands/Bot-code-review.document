const { SlashCommandBuilder, EmbedBuilder, ActionRowBuilder, ButtonBuilder, ButtonStyle } = require('discord.js');
const newsApi = require('../../utils/newsApi');

module.exports = {
    data: new SlashCommandBuilder()
      .setName('news')
      .setDescription('Get latest football news')
      .addStringOption(opt => opt.setName('team').setDescription('Filter by team name').setRequired(false))
      .addStringOption(opt => opt.setName('type').setDescription('News type').addChoices(
            { name: 'General', value: 'general' },
            { name: 'Transfers', value: 'transfers' }
        ).setRequired(false)),

    async execute(interaction) {
        await interaction.deferReply();
        const team = interaction.options.getString('team');
        const type = interaction.options.getString('type');

        try {
            let articles;
            if (type === 'transfers') {
                articles = await newsApi.getTransferNews();
            } else if (team) {
                articles = await newsApi.getTeamNews(team);
            } else {
                articles = await newsApi.getFootballNews();
            }

            if (!articles.length) return interaction.editReply('No news found right now 📰');

            const article = articles[0];
            const embed = new EmbedBuilder()
              .setColor(0x00BFFF)
              .setTitle('📰 Football News')
              .setDescription(`**${article.title}**\n\n${article.description || 'Click below to read more'}`)
              .setImage(article.urlToImage)
              .setFooter({ text: `Goalwire • ${article.source.name} • ${new Date(article.publishedAt).toLocaleDateString()}` })
              .setTimestamp();

            const row = new ActionRowBuilder().addComponents(
                new ButtonBuilder()
                  .setLabel('Read Full Article')
                  .setStyle(ButtonStyle.Link)
                  .setURL(article.url),
                new ButtonBuilder()
                  .setCustomId('news_next_1')
                  .setLabel('Next Article')
                  .setStyle(ButtonStyle.Secondary)
                  .setEmoji('➡️')
            );

            await interaction.editReply({ embeds: [embed], components: [row] });
        } catch (e) {
            await interaction.editReply('NewsAPI error — check your API key or rate limit');
        }
    }
};